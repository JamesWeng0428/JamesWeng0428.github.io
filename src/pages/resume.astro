---
import OGImage from '../assets/blog-placeholder-5.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import { fade } from 'astro:transitions';
import { SITE_TITLE } from '../consts';
---

<BaseLayout
	title={`Resume | ${SITE_TITLE}`}
	description="James Weng's resume — CS + Education at UIUC, software engineering and research experience."
	image={OGImage}
>
	<main id="main-content" class="resume-page" transition:animate={fade({ duration: '0.3s' })}>
		<div class="resume-toolbar">
			<a href="/resume.pdf" download class="download-btn">
				<span>Download PDF</span>
				<span aria-hidden="true">↓</span>
			</a>
		</div>

		<article class="latex">
			<header class="cv-head">
				<h1>ZHIHENG (JAMES) WENG</h1>
				<p class="cv-contact">
					312-536-6979 <span class="sep">|</span>
					<a href="mailto:zweng7@illinois.edu">zweng7@illinois.edu</a>
					<span class="sep">|</span>
					<a
						href="https://www.linkedin.com/in/JamesWeng0428"
						target="_blank"
						rel="noopener noreferrer">linkedin.com/in/JamesWeng0428</a
					>
					<span class="sep">|</span>
					<a href="https://github.com/JamesWeng0428" target="_blank" rel="noopener noreferrer"
						>github.com/JamesWeng0428</a
					>
				</p>
			</header>

			<section class="cv-section">
				<h2>Education</h2>

				<div class="entry">
					<div class="entry-row">
						<span class="left"><strong>University of Illinois Urbana-Champaign</strong></span>
						<span class="right">Aug 2024 – Dec 2026</span>
					</div>
					<div class="entry-row">
						<span class="left italic">B.S. Computer Science + Education (Learning Sciences)</span>
						<span class="right">GPA: 3.80 / 4.00</span>
					</div>
					<div class="entry-row">
						<span class="left italic">James Scholar Honor, Grainger College of Engineering</span>
						<span class="right">Fall 2025 – Present</span>
					</div>
				</div>

				<div class="entry">
					<div class="entry-row">
						<span class="left"><strong>Massachusetts Institute of Technology</strong></span>
						<span class="right">Summer 2023</span>
					</div>
					<div class="entry-row">
						<span class="left italic">Game Lab Summer School</span>
					</div>
				</div>

				<div class="entry">
					<div class="entry-row">
						<span class="left"><strong>Stanford AI4ALL</strong></span>
						<span class="right">Summer 2020</span>
					</div>
					<div class="entry-row">
						<span class="left italic">Scholar — Computer Science &amp; AI Research</span>
					</div>
				</div>
			</section>

			<section class="cv-section">
				<h2>Technical Skills</h2>

				<div class="entry skills">
					<div class="skill-row">
						<span class="skill-label">Languages</span>
						<span class="skill-value">Python, C, C++, Swift, Java</span>
					</div>
					<div class="skill-row">
						<span class="skill-label">Backend &amp; Data</span>
						<span class="skill-value"
							>SQLite, REST APIs, pandas, NumPy, real-time data pipelines</span
						>
					</div>
					<div class="skill-row">
						<span class="skill-label">ML / AI</span>
						<span class="skill-value">LLMs, PyTorch, TensorFlow, scikit-learn, WhisperX</span>
					</div>
					<div class="skill-row">
						<span class="skill-label">Tools</span>
						<span class="skill-value">Git, CI/CD, pytest, Linux, bash, Make, Valgrind, GDB</span>
					</div>
				</div>
			</section>

			<section class="cv-section">
				<h2>Research</h2>

				<div class="entry">
					<div class="entry-row">
						<span class="left"><strong>Dept. of Educational Psychology, U Illinois</strong></span>
						<span class="right">Spring 2026 – Present</span>
					</div>
					<div class="entry-row">
						<span class="left italic"
							>Undergraduate Researcher — Causal Effect of College Education on SEB Skill
							Development</span
						>
					</div>
					<ul>
						<li>
							Contributing to a study across a 30,000-person longitudinal dataset, estimating the
							causal effect of college education on SEB skill development
						</li>
						<li>
							Supporting research design, data organization, and pipeline setup for Causal Forest +
							AIPW modeling; targeting peer-reviewed publication
						</li>
					</ul>
				</div>

				<div class="entry">
					<div class="entry-row">
						<span class="left"
							><strong>Undergraduate Research Scientific Advancement (URSA)</strong></span
						>
						<span class="right">Spring 2026</span>
					</div>
					<div class="entry-row">
						<span class="left italic"
							>Undergraduate Researcher — LLM-Based Mathematical Equation Relation Extraction</span
						>
					</div>
					<ul>
						<li>
							Completed 100+ annotations on a mathematical derivation graph dataset; contributions
							support model training for LLM-based equation relation extraction; project targets
							conference publication
						</li>
					</ul>
				</div>
			</section>

			<section class="cv-section">
				<h2>Experience</h2>

				<div class="entry">
					<div class="entry-row">
						<span class="left"
							><strong>Siebel School of Computing &amp; Data Science, U Illinois</strong></span
						>
						<span class="right">Aug 2025 – Aug 2026</span>
					</div>
					<div class="entry-row">
						<span class="left italic">Course Assistant — CS124 (Intro to Computer Science)</span>
					</div>
					<ul>
						<li>
							Guide 300 students through problem decomposition on assignments spanning data
							structures, algorithms, and programming
						</li>
						<li>
							Identify and address conceptual gaps through weekly office hours; translate complex
							technical concepts for diverse learning backgrounds
						</li>
					</ul>
				</div>
			</section>

			<section class="cv-section">
				<h2>Projects</h2>

				<div class="entry">
					<div class="entry-row">
						<span class="left"
							><strong>OhMyTSS — iOS Fitness Analytics App</strong>
							<span class="muted">(Swift)</span></span
						>
						<span class="right">Nov 2025 – Present</span>
					</div>
					<div class="entry-row">
						<span class="left italic"
							>Co-Founder &amp; Developer <span class="badge">Live on App Store</span></span
						>
					</div>
					<ul>
						<li>
							Integrated Apple HealthKit to ingest and process real-time wearable sensor streams,
							turning raw workout data into readiness and training-load insights with on-device,
							privacy-first architecture
						</li>
						<li>
							Diagnose user-reported issues, implement data parsing and validation fixes, and ship
							stability improvements to an active user base
						</li>
					</ul>
				</div>

				<div class="entry">
					<div class="entry-row">
						<span class="left"
							><strong>Meeting Minion — AI Meeting Summarizer</strong>
							<span class="muted">(Python)</span></span
						>
						<span class="right">Aug 2025 – Jan 2026</span>
					</div>
					<div class="entry-row">
						<span class="left italic">Team Lead &amp; Developer, SSCDS</span>
					</div>
					<ul>
						<li>
							Led full lifecycle development of a production AI app with real users: designed
							architecture, coordinated a cross-functional team, and deployed an end-to-end
							transcription + summarization pipeline
						</li>
						<li>
							Integrated a third-party LLM (Ollama) and WhisperX transcription with SQLite
							persistence; enforced engineering standards via CI/CD, PR reviews, and a pytest suite
							(64+ tests, 100% pass rate)
						</li>
					</ul>
				</div>

				<div class="entry">
					<div class="entry-row">
						<span class="left"
							><strong>Seizure Prediction Wristband — Patented Device</strong>
							<span class="muted">(C / C++)</span></span
						>
						<span class="right">2022 – 2024</span>
					</div>
					<div class="entry-row">
						<span class="left italic"
							>Initiator &amp; Team Lead <span class="badge">German Patent</span></span
						>
					</div>
					<ul>
						<li>
							Built a real-time embedded ML pipeline: ingested heart-rate and humidity sensor
							streams, engineered time-series features, and deployed an on-device classifier
							(cross-validated) for pre-seizure detection
						</li>
						<li>
							Managed the full project lifecycle from hardware prototyping to algorithm deployment;
							resulted in a registered German utility patent and a peer-reviewed publication
						</li>
					</ul>
				</div>
			</section>

			<section class="cv-section">
				<h2>Publication &amp; Patent</h2>

				<div class="entry">
					<p class="cite-label">Publication</p>
					<p class="cite">
						Weng, Z. (2023). <em
							>Prediction and Recognition of Epileptic Seizures Based on Artificial Intelligence</em
						>. Highlights in Science, Engineering and Technology, 72, 1092–1098.<br />
						<a href="https://doi.org/10.54097/gp3axg67" target="_blank" rel="noopener noreferrer"
							>doi.org/10.54097/gp3axg67</a
						>
					</p>
				</div>

				<div class="entry">
					<p class="cite-label">Patent</p>
					<p class="cite">
						Weng, Zhiheng (2024). <em>Epilepsy Early-Warning Wristband</em>. German Utility Patent
						DE 20 2023 107 669; filed Dec 26, 2023; registered Jan 25, 2024.
					</p>
				</div>
			</section>

			<section class="cv-section">
				<h2>Awards</h2>

				<div class="entry">
					<ul>
						<li>
							<span class="bullet-row">
								<span>AIME — 11/15</span>
								<span class="right-inline">2023</span>
							</span>
						</li>
						<li>
							<span class="bullet-row">
								<span>AMC 12 — Top 1%, 135/150</span>
								<span class="right-inline">2022</span>
							</span>
						</li>
						<li>
							<span class="bullet-row">
								<span>USACO Gold Division</span>
								<span class="right-inline">2021 – 2022</span>
							</span>
						</li>
					</ul>
				</div>
			</section>
		</article>
	</main>

	<style>
		.resume-page {
			max-width: var(--col);
			margin: 0 auto;
			padding: var(--space-2xl) 1.5rem;
		}

		.resume-toolbar {
			display: flex;
			justify-content: flex-end;
			margin-bottom: var(--space-lg);
		}

		.download-btn {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			padding: 0.55rem 1.1rem;
			border: 1px solid var(--ink);
			border-radius: 999px;
			color: var(--ink);
			background: transparent;
			text-decoration: none;
			font-family: var(--font-body);
			font-size: 0.85rem;
			font-weight: 500;
			letter-spacing: 0.02em;
			transition:
				background 0.2s,
				color 0.2s,
				transform 0.2s;
		}
		.download-btn:hover {
			background: var(--ink);
			color: var(--bg);
			transform: translateY(-1px);
		}

		/* The resume reads as part of the site — inherits palette + body type */
		.latex {
			color: var(--ink);
			background: transparent;
			font-family: var(--font-body);
			font-size: 1rem;
			line-height: 1.65;
		}

		.cv-head {
			text-align: left;
			margin-bottom: 2.5rem;
			padding-bottom: 1.25rem;
			border-bottom: 1px solid var(--rule);
		}
		.cv-head h1 {
			font-family: var(--font-display);
			font-size: clamp(2.25rem, 5vw, 3.25rem);
			font-weight: 400;
			letter-spacing: -0.02em;
			line-height: 1.05;
			margin: 0 0 0.6rem;
			color: var(--ink);
		}
		.cv-contact {
			font-family: var(--font-mono);
			font-size: 0.78rem;
			letter-spacing: 0.04em;
			margin: 0;
			color: var(--ink-mute);
		}
		.cv-contact a {
			color: var(--ink-soft);
			text-decoration: underline;
			text-decoration-color: var(--rule);
			text-underline-offset: 3px;
			transition:
				color 0.2s,
				text-decoration-color 0.2s;
		}
		.cv-contact a:hover {
			color: var(--accent);
			text-decoration-color: var(--accent);
		}
		.cv-contact .sep {
			margin: 0 0.4rem;
			color: var(--rule);
		}

		.cv-section {
			margin-top: 2.5rem;
		}
		.cv-section h2 {
			font-family: var(--font-mono);
			font-size: 0.72rem;
			font-weight: 500;
			text-transform: uppercase;
			letter-spacing: 0.14em;
			margin: 0 0 1.25rem;
			padding-bottom: 0.5rem;
			border-bottom: 1px solid var(--rule);
			color: var(--ink-mute);
		}

		.entry {
			margin: 0 0 1.75rem;
		}
		.entry:last-child {
			margin-bottom: 0;
		}
		.entry-row {
			display: flex;
			justify-content: space-between;
			align-items: baseline;
			gap: 1.5rem;
		}
		.entry-row .left {
			text-align: left;
			color: var(--ink);
		}
		.entry-row .left strong {
			font-family: var(--font-display);
			font-weight: 400;
			font-size: 1.2rem;
			letter-spacing: -0.01em;
			color: var(--ink);
		}
		.entry-row .right {
			text-align: right;
			white-space: nowrap;
			font-family: var(--font-mono);
			font-size: 0.72rem;
			letter-spacing: 0.06em;
			color: var(--ink-mute);
			text-transform: uppercase;
		}
		.italic {
			font-style: italic;
			color: var(--ink-soft);
		}
		.muted {
			color: var(--ink-mute);
			font-style: normal;
		}

		/* Small caps-y tag for "Live on App Store" / "German Patent" */
		.badge {
			display: inline-block;
			margin-left: 0.5rem;
			padding: 0.1rem 0.45rem;
			border: 1px solid var(--rule);
			border-radius: 3px;
			font-family: var(--font-mono);
			font-style: normal;
			font-size: 0.62rem;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: var(--ink-mute);
			vertical-align: 0.1em;
		}

		/* Skills read as a label/value list rather than prose */
		.skill-row {
			display: flex;
			gap: 1.5rem;
			align-items: baseline;
			margin: 0 0 0.55rem;
		}
		.skill-row:last-child {
			margin-bottom: 0;
		}
		.skill-label {
			flex: 0 0 8.5rem;
			font-family: var(--font-mono);
			font-size: 0.68rem;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: var(--ink-mute);
		}
		.skill-value {
			color: var(--ink-soft);
		}

		.cite-label {
			font-family: var(--font-mono);
			font-size: 0.68rem;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: var(--ink-mute);
			margin: 0 0 0.35rem;
		}
		.cite {
			margin: 0;
			color: var(--ink-soft);
			line-height: 1.55;
		}
		.cite a {
			font-family: var(--font-mono);
			font-size: 0.8rem;
			color: var(--ink-soft);
			text-decoration: underline;
			text-decoration-color: var(--rule);
			text-underline-offset: 3px;
			transition:
				color 0.2s,
				text-decoration-color 0.2s;
		}
		.cite a:hover {
			color: var(--accent);
			text-decoration-color: var(--accent);
		}

		.entry ul {
			margin: 0.6rem 0 0;
			padding-left: 1.1rem;
			color: var(--ink-soft);
		}
		.entry li {
			margin: 0.3rem 0;
			line-height: 1.55;
		}
		.entry li::marker {
			color: var(--ink-mute);
		}

		/* Bulleted rows that also carry a right-aligned date */
		.bullet-row {
			display: inline-flex;
			justify-content: space-between;
			width: 100%;
			gap: 1rem;
			align-items: baseline;
		}
		.bullet-row .right-inline {
			white-space: nowrap;
			font-family: var(--font-mono);
			font-size: 0.72rem;
			letter-spacing: 0.06em;
			color: var(--ink-mute);
		}

		@media (max-width: 680px) {
			.entry-row {
				flex-direction: column;
				gap: 0.25rem;
			}
			.entry-row .right {
				text-align: left;
			}
			.bullet-row {
				flex-direction: column;
				gap: 0.15rem;
			}
			.skill-row {
				flex-direction: column;
				gap: 0.15rem;
			}
			.skill-label {
				flex: none;
			}
		}

		@media print {
			.resume-toolbar {
				display: none;
			}
		}
	</style>
</BaseLayout>
