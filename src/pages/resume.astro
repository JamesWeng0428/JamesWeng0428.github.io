---
import OGImage from '../assets/blog-placeholder-5.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import { fade } from 'astro:transitions';
import { SITE_TITLE } from '../consts';
import { t } from '../i18n';

const c = t.en.resume;
---

<BaseLayout
	title={`Resume | ${SITE_TITLE}`}
	description="James Weng's resume — CS + Education at UIUC, software engineering and research experience."
	image={OGImage}
>
	<main id="main-content" class="resume-page" transition:animate={fade({ duration: '0.3s' })}>
		<div class="resume-toolbar">
			<a href="/resume.pdf" download class="download-btn">
				<span>{c.download}</span>
				<span aria-hidden="true">↓</span>
			</a>
		</div>

		<article class="latex">
			<header class="cv-head">
				<h1>{c.name}</h1>
				<p class="cv-contact">
					<a href={`tel:${c.phone}`}>{c.phone}</a>
					<span class="sep">|</span>
					<a href={`mailto:${c.email}`}>{c.email}</a>
					<span class="sep">|</span>
					<a href={`https://${c.website}`}>{c.website}</a>
				</p>
			</header>

			{
				c.sections.map((section) => (
					<section class="cv-section">
						<h2>{section.title}</h2>
						{section.items.map((item) => (
							<div class="entry">
								<div class="entry-row">
									<span class="left">
										<strong>{item.title}</strong>
									</span>
									{item.right && <span class="right">{item.right}</span>}
								</div>
								{item.subtitle && (
									<div class="entry-row">
										<span class="left italic">{item.subtitle}</span>
										{item.subtitleRight && <span class="right">{item.subtitleRight}</span>}
									</div>
								)}
								{item.notes.map((note) => (
									<div class="entry-row">
										<span class="left">{note.text}</span>
										{note.right && <span class="right">{note.right}</span>}
									</div>
								))}
								{item.bullets.length > 0 && (
									<ul>
										{item.bullets.map((bullet) => (
											<li>
												{bullet.right ? (
													<span class="bullet-row">
														<span>{bullet.text}</span>
														<span class="right-inline">{bullet.right}</span>
													</span>
												) : (
													bullet.text
												)}
											</li>
										))}
									</ul>
								)}
							</div>
						))}
					</section>
				))
			}
		</article>
	</main>

	<style>
		.resume-page {
			max-width: var(--col);
			margin: 0 auto;
			padding: var(--space-2xl) 1.5rem;
		}

		.resume-toolbar {
			display: flex;
			justify-content: flex-end;
			margin-bottom: var(--space-lg);
		}

		.download-btn {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			padding: 0.55rem 1.1rem;
			border: 1px solid var(--ink);
			border-radius: 999px;
			color: var(--ink);
			background: transparent;
			text-decoration: none;
			font-family: var(--font-body);
			font-size: 0.85rem;
			font-weight: 500;
			letter-spacing: 0.02em;
			transition:
				background 0.2s,
				color 0.2s,
				transform 0.2s;
		}
		.download-btn:hover {
			background: var(--ink);
			color: var(--bg);
			transform: translateY(-1px);
		}

		/* The resume reads as part of the site — inherits palette + body type */
		.latex {
			color: var(--ink);
			background: transparent;
			font-family: var(--font-body);
			font-size: 1rem;
			line-height: 1.65;
		}

		.cv-head {
			text-align: left;
			margin-bottom: 2.5rem;
			padding-bottom: 1.25rem;
			border-bottom: 1px solid var(--rule);
		}
		.cv-head h1 {
			text-transform: uppercase;
			font-family: var(--font-display);
			font-size: clamp(2.25rem, 5vw, 3.25rem);
			font-weight: 400;
			letter-spacing: -0.02em;
			line-height: 1.05;
			margin: 0 0 0.6rem;
			color: var(--ink);
		}
		.cv-contact {
			overflow-wrap: anywhere;
			font-family: var(--font-mono);
			font-size: 0.78rem;
			letter-spacing: 0.04em;
			margin: 0;
			color: var(--ink-mute);
		}
		.cv-contact a {
			color: var(--ink-soft);
			text-decoration: underline;
			text-decoration-color: var(--rule);
			text-underline-offset: 3px;
			transition:
				color 0.2s,
				text-decoration-color 0.2s;
		}
		.cv-contact a:hover {
			color: var(--accent);
			text-decoration-color: var(--accent);
		}
		.cv-contact .sep {
			margin: 0 0.4rem;
			color: var(--rule);
		}

		.cv-section {
			margin-top: 2.5rem;
		}
		.cv-section h2 {
			font-family: var(--font-mono);
			font-size: var(--text-label);
			font-weight: 500;
			text-transform: uppercase;
			letter-spacing: 0.14em;
			margin: 0 0 1.25rem;
			padding-bottom: 0.5rem;
			border-bottom: 1px solid var(--rule);
			color: var(--ink-mute);
		}

		.entry {
			margin: 0 0 1.75rem;
		}
		.entry:last-child {
			margin-bottom: 0;
		}
		.entry-row {
			display: flex;
			justify-content: space-between;
			align-items: baseline;
			gap: 1.5rem;
		}
		.entry-row .left {
			text-align: left;
			color: var(--ink);
		}
		.entry-row .left strong {
			font-family: var(--font-display);
			font-weight: 400;
			font-size: 1.2rem;
			letter-spacing: -0.01em;
			color: var(--ink);
		}
		.entry-row .right {
			text-align: right;
			white-space: nowrap;
			font-family: var(--font-mono);
			font-size: var(--text-label-sm);
			letter-spacing: 0.06em;
			color: var(--ink-mute);
			text-transform: uppercase;
		}
		.italic {
			font-style: italic;
			color: var(--ink-soft);
		}
		.entry ul {
			margin: 0.6rem 0 0;
			padding-left: 1.1rem;
			color: var(--ink-soft);
		}
		.entry li {
			margin: 0.3rem 0;
			line-height: 1.55;
		}
		.entry li::marker {
			color: var(--ink-mute);
		}

		/* Bulleted rows that also carry a right-aligned date */
		.bullet-row {
			display: inline-flex;
			justify-content: space-between;
			width: 100%;
			gap: 1rem;
			align-items: baseline;
		}
		.bullet-row .right-inline {
			white-space: nowrap;
			font-family: var(--font-mono);
			font-size: var(--text-label-sm);
			letter-spacing: 0.06em;
			color: var(--ink-mute);
		}

		@media (max-width: 680px) {
			.entry-row {
				flex-direction: column;
				gap: 0.25rem;
			}
			.entry-row .right {
				text-align: left;
			}
			.bullet-row {
				flex-direction: column;
				gap: 0.15rem;
			}
		}

		@media print {
			.resume-toolbar {
				display: none;
			}
		}
	</style>
</BaseLayout>
