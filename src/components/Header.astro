---
// src/components/Header.astro — replaces existing Header
import ThemeToggle from './ThemeToggle.astro';
import { t, type Lang, homeHref, sectionHref } from '../i18n';

interface Props {
	lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const nav = [
	{ href: sectionHref(lang, 'about'), label: t[lang].nav.about },
	{ href: sectionHref(lang, 'work'), label: t[lang].nav.work },
	{ href: sectionHref(lang, 'projects'), label: t[lang].nav.projects },
	{ href: sectionHref(lang, 'writing'), label: t[lang].nav.writing },
	{ href: sectionHref(lang, 'contact'), label: t[lang].nav.contact },
	{ href: '/resume', label: t[lang].nav.resume },
];
---

<nav class="nav">
	<div class="nav-inner">
		<a href={homeHref(lang)} class="nav-brand">
			<span class="dot"></span>
			<span>James Weng</span>
		</a>
		<div class="nav-links">
			{nav.map((n) => <a href={n.href}>{n.label}</a>)}
		</div>
		<div class="nav-status">
			<span class="ping"></span>
			<span class="status-text">{t[lang].nav.openToRoles}</span>
			<a class="lang-toggle" href={t[lang].nav.langToggleHref} aria-label="Switch language"
				>{t[lang].nav.langToggleLabel}</a
			>
			<ThemeToggle />
			<button
				class="nav-toggle"
				id="nav-toggle"
				aria-label="Open menu"
				aria-controls="mobile-menu"
				aria-expanded="false"
			>
				<svg
					class="icon-open"
					width="20"
					height="20"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					aria-hidden="true"
				>
					<line x1="3" y1="6" x2="21" y2="6"></line>
					<line x1="3" y1="12" x2="21" y2="12"></line>
					<line x1="3" y1="18" x2="21" y2="18"></line>
				</svg>
				<svg
					class="icon-close"
					width="20"
					height="20"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					aria-hidden="true"
				>
					<line x1="18" y1="6" x2="6" y2="18"></line>
					<line x1="6" y1="6" x2="18" y2="18"></line>
				</svg>
			</button>
		</div>
	</div>
	<div class="mobile-menu" id="mobile-menu">
		{nav.map((n) => <a href={n.href}>{n.label}</a>)}
	</div>
</nav>

<style>
	.lang-toggle {
		font-family: var(--font-mono);
		font-size: var(--text-label-sm);
		letter-spacing: 0.04em;
		padding: 0.35em 0.55em;
		border: 1px solid var(--rule);
		border-radius: 4px;
		color: var(--ink-mute);
		text-decoration: none;
		transition:
			background 0.2s,
			color 0.2s,
			border-color 0.2s;
	}
	.lang-toggle:hover {
		background: var(--bg-raised);
		border-color: var(--ink-mute);
		color: var(--ink);
	}
	.nav-status :global(.theme-toggle) {
		background: transparent;
		border: 1px solid var(--rule);
		color: var(--ink-mute);
		padding: 0.35em;
		border-radius: 4px;
	}
	.nav-status :global(.theme-toggle:hover) {
		background: var(--bg-raised);
		border-color: var(--ink-mute);
		color: var(--ink);
	}
	.nav-status :global(.theme-toggle svg) {
		width: 16px;
		height: 16px;
	}

	/* Hamburger — hidden on desktop, revealed at the mobile breakpoint */
	.nav-toggle {
		display: none;
		background: transparent;
		border: 1px solid var(--rule);
		color: var(--ink-mute);
		padding: 0.35em;
		border-radius: 4px;
		cursor: pointer;
		align-items: center;
		justify-content: center;
		transition:
			background 0.2s,
			color 0.2s,
			border-color 0.2s;
	}
	.nav-toggle:hover {
		background: var(--bg-raised);
		border-color: var(--ink-mute);
		color: var(--ink);
	}
	.nav-toggle:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.nav-toggle svg {
		display: block;
	}
	.nav-toggle .icon-close {
		display: none;
	}
	.nav-toggle[aria-expanded='true'] .icon-open {
		display: none;
	}
	.nav-toggle[aria-expanded='true'] .icon-close {
		display: block;
	}

	/* Mobile dropdown panel — collapsed by default, .open reveals it on mobile */
	.mobile-menu {
		display: none;
		flex-direction: column;
		padding: 0.25rem 1.5rem 1rem;
	}
	.mobile-menu a {
		padding: 0.85rem 0;
		font-size: 1rem;
		color: var(--ink-soft);
		border-bottom: 1px solid var(--rule-soft);
		transition:
			color 0.2s,
			padding-left 0.2s;
	}
	.mobile-menu a:last-child {
		border-bottom: none;
	}
	.mobile-menu a:hover {
		color: var(--ink);
		padding-left: 0.35rem;
	}

	@media (max-width: 680px) {
		.nav-toggle {
			display: inline-flex;
		}
		.mobile-menu.open {
			display: flex;
		}
		.nav-status .ping,
		.nav-status .status-text {
			display: none;
		}
	}
</style>

<script>
	(function () {
		let escBound = false;

		function bindNav() {
			const toggle = document.getElementById('nav-toggle');
			const menu = document.getElementById('mobile-menu');
			if (!toggle || !menu) return;

			if (toggle.dataset.bound !== 'true') {
				toggle.dataset.bound = 'true';

				const setOpen = (open: boolean) => {
					toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
					toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
					menu.classList.toggle('open', open);
				};

				toggle.addEventListener('click', () => {
					setOpen(toggle.getAttribute('aria-expanded') !== 'true');
				});

				menu.querySelectorAll('a').forEach((link) => {
					link.addEventListener('click', () => setOpen(false));
				});
			}

			// Bind Escape once at the document level; re-query elements at fire time
			// so it keeps working across view transitions.
			if (!escBound) {
				escBound = true;
				document.addEventListener('keydown', (e: KeyboardEvent) => {
					if (e.key !== 'Escape') return;
					const t = document.getElementById('nav-toggle');
					const m = document.getElementById('mobile-menu');
					if (!t || !m) return;
					t.setAttribute('aria-expanded', 'false');
					t.setAttribute('aria-label', 'Open menu');
					m.classList.remove('open');
				});
			}
		}

		bindNav();
		document.addEventListener('astro:page-load', bindNav);
	})();
</script>
