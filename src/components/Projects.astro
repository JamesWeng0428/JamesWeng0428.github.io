---
import SectionHead from './SectionHead.astro';
import { t, type Lang } from '../i18n';

interface Props {
	lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const c = t[lang].projects;
---

<section id="projects">
	<div class="wrap">
		<SectionHead num={c.sectionNum} title={c.sectionTitle} titleEm={c.sectionTitleEm} />
		<div class="projects">
			{
				c.items.map((p) => {
					const inner = (
						<>
							<div class="project-head">
								<h3 class="project-title">{p.title}</h3>
								<span class="project-year">{p.year}</span>
							</div>
							<p class="project-desc">{p.desc}</p>
							<div class="project-tags">
								{p.tags.map((t) => (
									<span>{t}</span>
								))}
							</div>
						</>
					);
					return (
						<article class="project">
							{p.url ? (
								<a href={p.url} target="_blank" rel="noopener noreferrer" class="project-link">
									{inner}
								</a>
							) : (
								inner
							)}
							{'resources' in p && (
								<ul class="project-resources">
									{p.resources.map((link) => (
										<li>
											<a href={link.href}>{link.label}</a>
										</li>
									))}
								</ul>
							)}
						</article>
					);
				})
			}
		</div>
	</div>
</section>

<style>
	.project-resources {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
		list-style: none;
		padding: 0;
		font-size: var(--text-sm);
	}
	.project-resources a {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.project-link {
		color: inherit;
		text-decoration: none;
		display: block;
	}
	/* Stretch the hit area over the whole card, including its padding. */
	.project-link::after {
		content: '';
		position: absolute;
		inset: 0;
	}
	/* Ring the whole card rather than just the inner text box. */
	.project-link:focus-visible {
		outline: none;
	}
	.project:has(.project-link:focus-visible) {
		outline: 2px solid var(--accent);
		outline-offset: -2px;
	}
</style>
